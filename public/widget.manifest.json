{
  "protocolVersion": "1.0",
  "id": "virtual-office",
  "packageId": "com.techies.widget.virtual-office",
  "name": "Virtual Office",
  "icon": "🏢",
  "version": "3.0.0",
  "category": "collaboration",
  "author": "Techies Official",
  "description": "2Dフロア在席可視化、ダイレクトメッセージ（Gemma 4 リアルタイム通訳）、および就業規則準拠のAI秘書による自動予定調整を提供する独立アドオンウィジェット。",
  "entrypoints": {
    "main": "/index.html?view=office",
    "subViews": {
      "dm-chat": {
        "path": "/index.html?view=dm-chat",
        "title": "Direct Message",
        "defaultWidth": 420,
        "defaultHeight": 540
      }
    },
    "backgroundUnreadApi": "/api/vo/dm/unread"
  },
  "windowConfig": {
    "defaultWidth": 900,
    "defaultHeight": 620
  },
  "providesCapabilities": [
    {
      "id": "cap:vo:presence_read",
      "name": "フロア在席確認",
      "description": "オフィスマップ上の各メンバーの在席ルーム・リモート状況・オフライン状態を閲覧します。"
    },
    {
      "id": "cap:vo:presence_write",
      "name": "入退室・ダイレクトチャット・AIアバター生成",
      "description": "自身のルーム移動、他メンバーとのDM・ビデオ会議・カレンダー仮登録、AIアバター生成を実行します。"
    },
    {
      "id": "cap:vo:manage_assistant_rules",
      "name": "AI秘書ルール・就業条件管理",
      "description": "代理応答AIプロンプトおよび就業時間・休憩時間・バッファ設定を編集します（36協定コンプライアンス監査連携）。"
    }
  ],
  "permissionsSchema": {
    "readActions": [],
    "executeActions": [],
    "manageActions": [
      "action:manage_assistant_rules"
    ]
  },
